# EC2의 ~/churai/.env 로 복사한 뒤 값을 채웁니다. 실제 .env는 커밋하지 않습니다.

# docker-compose.yml의 이미지 이름에 사용 (Docker Hub 계정명)
DOCKER_USERNAME=

# RDS 접속 정보 (엔드포인트는 RDS 콘솔 > 연결 & 보안에서 확인)
SPRING_DATASOURCE_URL=jdbc:mysql://<RDS 엔드포인트>:3306/churai?useSSL=true&serverTimezone=Asia/Seoul
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# 32바이트 이상 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION=3600000

# 프론트 배포 주소를 콤마로 구분해 추가 (로컬 개발 주소는 기본 포함)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
